# Formspree endpoint for the contact form (recipient: mnc@kpsglobal.id)
# 1. Create or open the form at https://formspree.io and set the recipient email
# 2. Copy the form endpoint (e.g. https://formspree.io/f/xxxxxxxx)
# 3. Copy this file to .env.local and paste the endpoint
# In CI the same value comes from the repository variable VITE_FORMSPREE_ENDPOINT.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Owner password for documents issued with `npm run docs:issue` (local only, never in git).
# It forbids editing and copying text in the issued PDF; the file still opens without a password.
KPS_PDF_OWNER_PASSWORD=
